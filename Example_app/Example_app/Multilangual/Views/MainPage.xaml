<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Example_app.Multilangual.Views.MainPage"
             Title="Languages">
    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="25">
            <Label Text="{Binding Greeting}"
                   FontSize="32"
                   HorizontalOptions="Center" />

            <Label Text="{Binding ChangeLanguageLabel}"
                   FontAttributes="Bold"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <Button Text="{Binding EnglishButton}"
                    Command="{Binding SetEnglishCommand}" />
            <Button Text="{Binding EstonianButton}"
                    Command="{Binding SetEstonianCommand}" />
            <Button Text="{Binding RussianButton}"
                    Command="{Binding SetRussianCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
