<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Example_app.Services"
             xmlns:vm="clr-namespace:Example_app.ViewModels"
             x:Class="Example_app.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{services:Translate Settings}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="600">
            <Label Text="{services:Translate Settings}" FontSize="28" FontAttributes="Bold" />
            <Label Text="{services:Translate Language}" />
            <Picker Title="{services:Translate Language}" ItemsSource="{Binding Languages}"
                    SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
            <Label Text="{services:Translate Theme}" />
            <Picker Title="{services:Translate Theme}" ItemsSource="{Binding Themes}"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
            <Label Text="{services:Translate Opponent}" />
            <Picker Title="{services:Translate Opponent}" ItemsSource="{Binding GameModes}"
                    SelectedIndex="{Binding GameModeIndex, Mode=TwoWay}" />
            <Label Text="{services:Translate SettingsSaved}" FontSize="14" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Button Text="{services:Translate Back}" Clicked="OnBackClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
